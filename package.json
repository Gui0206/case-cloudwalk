{
  "name": "central-helpdesk",
  "version": "1.0.0",
  "description": "Help desk multi-marcas com simulação de regras e integração Kafka",
  "scripts": {
    "test": "docker build --target build -q .",
    "start": "./iniciar.command",
    "experiment": "node scripts/experiment.js",
    "test:faults": "node scripts/faults.js",
    "format": "prettier --write public scripts",
    "test:load": "node scripts/load.js",
    "test:sustained": "node scripts/sustained.js",
    "test:varied": "node --env-file=.env scripts/varied.js --with-outage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "kafkajs": "2.2.4",
    "pg": "8.23.1"
  },
  "type": "module",
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
